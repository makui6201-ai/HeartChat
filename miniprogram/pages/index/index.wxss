/* ============================================================
   Character Selection Page
   Design: soft gradient background, fullscreen portrait cards
   ============================================================ */

page {
  background: linear-gradient(135deg, #fff5f5 0%, #f0f4ff 100%);
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* ---- Header ---- */
.page-header {
  padding: 96rpx 24rpx 64rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
  letter-spacing: 8rpx;
  text-transform: uppercase;
}

/* ---- Card list ---- */
.card-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
}

/* ---- Individual card ---- */
.character-card {
  position: relative;
  overflow: hidden;
  border-radius: 80rpx;
  background: #fff;
  height: 45vh;
  transition: transform 0.3s ease;
  display: flex;
}

.character-card:active {
  transform: scale(0.97);
}

.boyfriend-shadow {
  box-shadow: 0 40rpx 60rpx rgba(147, 197, 253, 0.45);
}

.girlfriend-shadow {
  box-shadow: 0 40rpx 60rpx rgba(251, 207, 232, 0.5);
}

/* Portrait image fills the card */
.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* Gradient overlay for text legibility */
.card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, transparent 60%);
}

/* Text block in card bottom */
.card-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 64rpx;
}

.char-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.char-tag {
  display: block;
  font-size: 28rpx;
  color: rgba(219, 234, 254, 0.9); /* blue-50 */
  font-weight: 500;
  margin-bottom: 16rpx;
}

.pink-tag {
  color: rgba(252, 231, 243, 0.9); /* pink-100 */
}

.char-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(226, 232, 240, 0.9);
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ---- Footer ---- */
.page-footer {
  padding: 32rpx 24rpx 64rpx;
  text-align: center;
}

.footer-hint {
  font-size: 24rpx;
  color: #94a3b8;
}
