/* ============================================================
   Chat Page
   Design: soft pink/white gradient, iOS-like chat bubbles
   ============================================================ */

page {
  background: linear-gradient(180deg, #fff5f7 0%, #ffffff 100%);
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* ---- Header ---- */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1rpx solid #fce7f3;
  flex-shrink: 0;
  z-index: 10;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #f472b6;
}

.back-icon {
  font-size: 56rpx;
  line-height: 1;
  color: #f472b6;
  font-weight: 300;
}

/* Avatar with online indicator */
.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 30rpx rgba(255, 182, 193, 0.5);
}

.online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  background: #4ade80;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
}

.header-meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.header-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.3;
}

.header-status {
  font-size: 20rpx;
  color: #94a3b8;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  font-weight: 700;
}

/* Love badge */
.love-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fdf2f8;
  border: 1rpx solid #fce7f3;
  border-radius: 100rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(244, 114, 182, 0.1);
}

.love-heart {
  font-size: 28rpx;
  color: #ec4899;
}

.love-score {
  font-size: 24rpx;
  font-weight: 700;
  color: #db2777;
}

/* ---- Chat area ---- */
.chat-area {
  flex: 1;
  min-height: 0;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

/* Date divider */
.date-divider {
  display: flex;
  justify-content: center;
  margin: 16rpx 0 24rpx;
}

.date-label {
  font-size: 22rpx;
  color: #94a3b8;
  background: rgba(241, 245, 249, 0.5);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* ---- Message rows ---- */
.msg-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 24rpx;
}

.ai-row {
  justify-content: flex-start;
  gap: 16rpx;
}

.user-row {
  justify-content: flex-end;
}

/* Small avatar next to AI bubble */
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-bottom: 4rpx;
}

/* ---- Bubbles ---- */
.bubble {
  max-width: 60vw;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-bubble {
  background: #ffffff;
  border: 1rpx solid #f1f5f9;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.user-bubble {
  background: #ec4899;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(236, 72, 153, 0.3);
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #1e293b;
}

.user-bubble .bubble-text {
  color: #ffffff;
}

/* Time stamp */
.msg-time {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  text-align: right;
}

.user-time {
  color: rgba(255, 255, 255, 0.7);
}

.msg-meta-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 8rpx;
}

.checkmark {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ---- Typing indicator ---- */
.typing-bubble {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 32rpx;
  min-width: 80rpx;
}

.dot {
  font-size: 44rpx;
  line-height: 1;
  color: #cbd5e1;
}

.dot1 { animation: blink 1.2s infinite 0s; }
.dot2 { animation: blink 1.2s infinite 0.3s; }
.dot3 { animation: blink 1.2s infinite 0.6s; }

@keyframes blink {
  0%, 100% { opacity: 0.25; }
  50%       { opacity: 1; }
}

/* ---- Input bar ---- */
.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f1f5f9;
  flex-shrink: 0;
}

.textarea-wrap {
  flex: 1;
  background: #f8fafc;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
}

.msg-input {
  width: 100%;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1e293b;
  max-height: 160rpx;
}

.input-placeholder {
  color: #cbd5e1;
}

/* Send button */
.send-btn {
  width: 80rpx;
  height: 80rpx;
  min-height: 80rpx;
  background: #ec4899;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(236, 72, 153, 0.35);
  flex-shrink: 0;
  padding: 0;
  line-height: 80rpx;
}

.send-btn::after {
  border: none;
}

.send-btn-hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.send-btn-disabled {
  background: #e2e8f0;
  box-shadow: none;
}

.send-arrow {
  font-size: 32rpx;
  color: #ffffff;
  display: block;
  text-align: center;
  line-height: 80rpx;
  width: 80rpx;
}
