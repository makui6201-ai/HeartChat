# HeartChat server environment variables
# Copy to .env and fill in your actual values (never commit .env)

# DeepSeek API key – obtain from https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# HTTP port the server listens on (default: 8080)
PORT=8080

# Comma-separated allowed CORS origins (leave empty to allow all – dev only)
# Example for production: CORS_ORIGIN=https://servicewechat.com
CORS_ORIGIN=
