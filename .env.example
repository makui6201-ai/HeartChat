# HeartChat server environment variables
# Copy to .env and fill in your actual values (never commit .env)

# DeepSeek API key – obtain from https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# HTTP port the server listens on (default: 8080)
PORT=8080

# Comma-separated allowed CORS origins (leave empty to allow all – dev only)
# Example for production: CORS_ORIGIN=https://servicewechat.com
CORS_ORIGIN=

# WeChat Mini-Program credentials – required for user login (openId resolution)
# Obtain from https://mp.weixin.qq.com -> Settings -> Development Settings
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# Directory where per-user state (role, love score, history) is stored as JSON
# Mount a persistent volume to this path in production
DATA_DIR=./data
